@{
    ViewData["Title"] = "نظام تصاريح الدخول";
}

<!-- ═══════ شاشة الدخول الحديثة ═══════ -->
<div class="login-wrap" id="screenLogin">
  <div class="login-card">
    <aside class="login-art">
      <div class="login-art-glow"></div>
      <div class="login-art-top"><span class="login-art-chip">🛡️ منصة الوصول الآمن</span></div>
      <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" class="login-svg" aria-hidden="true">
        <defs>
          <linearGradient id="lgSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1e7a4f" stop-opacity=".55"/><stop offset="1" stop-color="#0d2518" stop-opacity="0"/></linearGradient>
          <linearGradient id="lgGold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e6b73e"/><stop offset="1" stop-color="#a07820"/></linearGradient>
          <linearGradient id="lgBld" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2f8f60"/><stop offset="1" stop-color="#15573a"/></linearGradient>
        </defs>
        <circle cx="200" cy="140" r="120" fill="url(#lgSky)"/>
        <circle cx="200" cy="140" r="96" fill="none" stroke="#c9941e" stroke-opacity=".25" stroke-dasharray="3 6"/>
        <rect x="40" y="168" width="64" height="92" rx="4" fill="url(#lgBld)" opacity=".75"/>
        <rect x="296" y="150" width="70" height="110" rx="4" fill="url(#lgBld)" opacity=".75"/>
        <g fill="#d6f0e2" opacity=".55"><rect x="52" y="182" width="12" height="12" rx="2"/><rect x="76" y="182" width="12" height="12" rx="2"/><rect x="52" y="206" width="12" height="12" rx="2"/><rect x="76" y="206" width="12" height="12" rx="2"/><rect x="308" y="166" width="12" height="12" rx="2"/><rect x="334" y="166" width="12" height="12" rx="2"/><rect x="308" y="192" width="12" height="12" rx="2"/><rect x="334" y="192" width="12" height="12" rx="2"/><rect x="308" y="218" width="12" height="12" rx="2"/><rect x="334" y="218" width="12" height="12" rx="2"/></g>
        <rect x="128" y="150" width="14" height="110" rx="3" fill="#0d2518" stroke="#c9941e" stroke-width="2"/>
        <rect x="258" y="150" width="14" height="110" rx="3" fill="#0d2518" stroke="#c9941e" stroke-width="2"/>
        <rect x="120" y="140" width="160" height="16" rx="8" fill="url(#lgGold)"/>
        <path d="M200 52 L252 72 V118 C252 148 230 170 200 182 C170 170 148 148 148 118 V72 Z" fill="#0f2d1f" stroke="url(#lgGold)" stroke-width="4"/>
        <path d="M176 116 L194 134 L228 96" fill="none" stroke="#e6b73e" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="20" y="258" width="360" height="6" rx="3" fill="#0a1f14" opacity=".6"/>
        <g><rect x="190" y="232" width="20" height="28" rx="3" fill="#c9941e" opacity=".9"/><circle cx="200" cy="224" r="6" fill="#c9941e" opacity=".9"/></g>
      </svg>
      <div class="login-art-title">تحكم كامل في الدخول والخروج</div>
      <div class="login-art-sub">من طلب التصريح حتى الاستعلام على البوابة — في نظام واحد مع قاعدة بيانات SQL Server.</div>
      <ul class="login-feats">
        <li><span>📝</span> طلبات تصاريح للأفراد والمركبات والخروج</li>
        <li><span>✅</span> مسار اعتماد واضح وصلاحيات حسب الدور</li>
        <li><span>🚪</span> بوابات بأكثر من جهاز واستعلام فوري بالـ MAC</li>
        <li><span>📜</span> سجل تدقيق كامل لكل حركة في النظام</li>
      </ul>
    </aside>
    <div class="login-main">
      <div class="login-security-badge">اتصال آمن وموثق</div>
      <div class="login-header">
        <div class="login-logo no-logo" id="loginLogo"></div>
        <div class="login-title" id="loginTitle">نظام تصاريح الدخول</div>
        <div class="login-title-sub">بوابة الوصول الآمن للمجمع — .NET 8 MVC & SQL Server</div>
      </div>
      <div class="login-body">
        <div class="login-error" id="loginError">⚠️ بيانات الدخول غير صحيحة</div>
        <div class="login-input-group">
          <label>👤 اسم المستخدم</label>
          <div class="login-input-wrap">
            <input type="text" id="loginUsername" placeholder="أدخل اسم المستخدم" autocomplete="username">
            <span class="login-input-icon">👤</span>
          </div>
        </div>
        <div class="login-input-group">
          <label>🔐 كلمة المرور</label>
          <div class="login-input-wrap">
            <input type="password" id="loginPassword" placeholder="أدخل كلمة المرور" onkeydown="if(event.key==='Enter')doLogin()" autocomplete="current-password">
            <span class="login-input-icon">🔒</span>
            <button type="button" class="login-password-toggle" onclick="togglePasswordVisibility()">👁️</button>
          </div>
        </div>
        <button class="login-btn" onclick="doLogin()">🔓 تسجيل الدخول</button>
        <div class="login-divider">أو الدخول السريع للتجربة</div>
        <div class="login-quick">
          <button onclick="fillDemo('admin')">👑 مدير</button>
          <button onclick="fillDemo('approver')">✅ معتمد</button>
          <button onclick="fillDemo('requester')">📝 مقدم</button>
          <button onclick="fillDemo('guard')">🛡️ حارس</button>
        </div>
      </div>
      <div class="login-footer">© 2026 <b>نظام تصاريح الدخول</b> — هندسة متعددة الطبقات (Layered Architecture)</div>
    </div>
  </div>
</div>

<!-- ═══════ الشريط العلوي ═══════ -->
<div class="topbar" id="mainTopbar" style="display:none">
  <button class="btn bg2 bxs menu-btn" onclick="document.querySelector('.sidebar').classList.toggle('open')">☰</button>
  <div class="topbar-logo">
    <div class="topbar-logo-ico" id="topbarLogoIco">🛡️</div>
    <span id="topbarSystemName">تصاريح الدخول</span>
  </div>
  <div class="topbar-nav" id="topbarNav">
    <button class="tnav active" data-screen="dashboard" onclick="goto('dashboard',this)">🏠 الرئيسية</button>
    <button class="tnav" data-screen="new-request" onclick="newReq();goto('new-request',this)">➕ طلب</button>
    <button class="tnav" data-screen="gate" onclick="goto('gate',this)">🛡️ استعلام</button>
    <button class="tnav" data-screen="my-requests" onclick="goto('my-requests',this)">📋 طلباتي</button>
    <button class="tnav" data-screen="approvals" onclick="goto('approvals',this)">📨 اعتماد <span class="badge bor2" id="tnavApprovalCount">0</span></button>
  </div>
  <div class="topbar-right">
    <div class="role-picker" id="branchPickerWrap">
      <span style="font-size:11px;color:rgba(255,255,255,.6)">🏢</span>
      <select id="branchSwitcher" onchange="setBranch(this.value)"></select>
    </div>
    <div class="user-badge">
      <div class="user-avatar" id="topUserAvatar">—</div>
      <div>
        <div class="user-name" id="topUserName">—</div>
        <div class="user-dept" id="topUserRoleLabel">—</div>
      </div>
    </div>
    <button class="topbar-action-btn gold" onclick="exportProjectZIP()" title="تصدير نسخة احتياطية من المشروع">
      📦 <span>تصدير</span>
    </button>
    <button class="topbar-action-btn danger" onclick="doLogout()" title="تسجيل الخروج">
      🚪 <span>خروج</span>
    </button>
  </div>
</div>

<div class="app-body" id="mainAppBody" style="display:none">
<div class="sidebar">
  <div class="sb-item active" data-screen="dashboard" onclick="goto('dashboard',null);setSb(this)"><span class="sb-ico">🏠</span>لوحة التحكم</div>
  <div class="sb-group"><div class="sb-group-header" onclick="this.parentElement.classList.toggle('collapsed')"><span>👥 الأشخاص والتصاريح</span><span>▾</span></div><div class="sb-group-body">
    <div class="sb-item" data-screen="new-request" onclick="newReq();goto('new-request',null);setSb(this)"><span class="sb-ico">➕</span>طلب تصريح</div>
    <div class="sb-item" data-screen="vehicle" onclick="goto('vehicle',null);setSb(this)"><span class="sb-ico">🚗</span>تصريح مركبة</div>
    <div class="sb-item" data-screen="exit-permit" onclick="openExit();setSb(this)"><span class="sb-ico">🚪</span>تصريح خروج</div>
    <div class="sb-item" data-screen="my-requests" onclick="goto('my-requests',null);setSb(this)"><span class="sb-ico">📋</span>طلباتي</div>
    <div class="sb-item" data-screen="registry" onclick="goto('registry',null);setSb(this)"><span class="sb-ico">🧑</span>سجل الأشخاص</div>
    <div class="sb-item" data-screen="permitslog" onclick="goto('permitslog',null);setSb(this)"><span class="sb-ico">📋</span>سجل التصاريح</div>
    <div class="sb-item" data-screen="approvals" onclick="goto('approvals',null);setSb(this)"><span class="sb-ico">📨</span>طلبات التصريح<span class="sb-badge" id="sbApprCount">0</span></div>
  </div></div>
  <div class="sb-group"><div class="sb-group-header" onclick="this.parentElement.classList.toggle('collapsed')"><span>🛡️ نقاط الدخول</span><span>▾</span></div><div class="sb-group-body">
    <div class="sb-item" data-screen="gate" onclick="goto('gate',null);setSb(this)"><span class="sb-ico">🛡️</span>شاشة الاستعلام</div>
    <div class="sb-item" data-screen="querylog" onclick="goto('querylog',null);setSb(this)"><span class="sb-ico">🧾</span>سجل الاستعلامات</div>
    <div class="sb-item" data-screen="cardprint" onclick="goto('cardprint',null);setSb(this)"><span class="sb-ico">🖨️</span>طباعة البطاقات</div>
    <div class="sb-item" data-screen="blacklist" onclick="goto('blacklist',null);setSb(this)"><span class="sb-ico">⛔</span>القائمة السوداء</div>
  </div></div>
  <div class="sb-group collapsed"><div class="sb-group-header" onclick="this.parentElement.classList.toggle('collapsed')"><span>⚙️ الإعدادات</span><span>▾</span></div><div class="sb-group-body">
    <div class="sb-item" data-screen="branches" onclick="goto('branches',null);setSb(this)"><span class="sb-ico">🏢</span>الفروع</div>
    <div class="sb-item" data-screen="buildings" onclick="goto('buildings',null);setSb(this)"><span class="sb-ico">🏬</span>المباني</div>
    <div class="sb-item" data-screen="paths" onclick="goto('paths',null);setSb(this)"><span class="sb-ico">🛣️</span>البوابات والمسارات</div>
    <div class="sb-item" data-screen="departments" onclick="goto('departments',null);setSb(this)"><span class="sb-ico">🏛️</span>الإدارات</div>
    <div class="sb-item" data-screen="lookups" onclick="goto('lookups',null);setSb(this)"><span class="sb-ico">📚</span>قوائم الاختيار</div>
    <div class="sb-item" data-screen="users" onclick="goto('users',null);setSb(this)"><span class="sb-ico">👤</span>المستخدمون</div>
    <div class="sb-item" data-screen="cardtemplate" onclick="goto('cardtemplate',null);setSb(this)"><span class="sb-ico">🪪</span>تصميم البطاقة</div>
    <div class="sb-item" data-screen="systemsettings" onclick="goto('systemsettings',null);setSb(this)"><span class="sb-ico">🛠️</span>الإعدادات</div>
  </div></div>
  <div class="sb-group collapsed"><div class="sb-group-header" onclick="this.parentElement.classList.toggle('collapsed')"><span>📊 التقارير</span><span>▾</span></div><div class="sb-group-body">
    <div class="sb-item" data-screen="reports" onclick="goto('reports',null);setSb(this)"><span class="sb-ico">📊</span>التقارير الشاملة</div>
    <div class="sb-item" data-screen="auditlog" onclick="goto('auditlog',null);setSb(this)"><span class="sb-ico">📜</span>سجل النظام</div>
  </div></div>
</div>

<div class="content">

<!-- لوحة التحكم -->
<div class="screen active" id="screen-dashboard">
  <div class="ph"><div><div class="pt" id="dashGreeting">👋 مرحباً</div><div class="ps" id="dashSub">نظرة عامة</div></div><button class="btn bg2" onclick="rd()">🔄 تحديث</button></div>
  <div id="dashKpis" class="grid4" style="margin-bottom:20px"></div>
  <div class="grid2" style="margin-bottom:20px">
    <div class="report-card"><div class="report-card-title">📊 حالة التصاريح</div><div id="dashStatusChart" class="bar-chart"></div></div>
    <div class="report-card"><div class="report-card-title">🏢 حسب الفرع</div><div id="dashBranchChart" class="bar-chart"></div></div>
  </div>
  <div class="grid2" style="margin-bottom:20px">
    <div class="report-card"><div class="report-card-title">🏬 حسب المبنى</div><div id="dashBuildingChart" class="bar-chart"></div></div>
    <div class="report-card"><div class="report-card-title">🏛️ حسب الإدارة</div><div id="dashDeptChart" class="bar-chart"></div></div>
  </div>
  <div class="grid5" style="margin-bottom:20px">
    <div class="stat-box"><div class="stat-ico">🏢</div><div class="stat-val" id="dashBranchesCount">0</div><div class="stat-lbl">الفروع</div></div>
    <div class="stat-box"><div class="stat-ico">🏬</div><div class="stat-val" id="dashBuildingsCount">0</div><div class="stat-lbl">المباني</div></div>
    <div class="stat-box"><div class="stat-ico">🚪</div><div class="stat-val" id="dashGatesCount">0</div><div class="stat-lbl">البوابات</div></div>
    <div class="stat-box"><div class="stat-ico">🛣️</div><div class="stat-val" id="dashPathsCount">0</div><div class="stat-lbl">المسارات</div></div>
    <div class="stat-box"><div class="stat-ico">🏛️</div><div class="stat-val" id="dashDepsCount">0</div><div class="stat-lbl">الإدارات</div></div>
  </div>
  <div class="tbl-wrap">
    <div class="tbl-head"><span class="tbl-title">📨 طلبات بانتظار الاعتماد (<span id="dashPendingCount">0</span>)</span><button class="btn bg2 bxs" onclick="goto('approvals',null)">عرض الكل</button></div>
    <table><thead><tr><th>الطلب</th><th>النوع</th><th>الفرع/المبنى</th></tr></thead><tbody id="dashPendingTable"></tbody></table>
    <div id="dashPendingEmpty" class="hint" style="display:none;padding:24px;text-align:center">لا توجد طلبات ✔</div>
  </div>
</div>

<!-- طلب جديد -->
<div class="screen" id="screen-new-request">
  <div class="ph"><div><div class="pt" id="newReqTitle">➕ طلب تصريح جديد</div></div></div>
  <div class="card" style="padding:24px">
    <div class="wiz-bar">
      <div class="wiz-step active" data-step="1"><div class="wiz-circle">1</div><div class="wiz-label">الأشخاص</div></div>
      <div class="wiz-step" data-step="2"><div class="wiz-circle">2</div><div class="wiz-label">الزيارة</div></div>
      <div class="wiz-step" data-step="3"><div class="wiz-circle">3</div><div class="wiz-label">المسموح</div></div>
      <div class="wiz-step" data-step="4"><div class="wiz-circle">4</div><div class="wiz-label">الإرسال</div></div>
    </div>
    <div class="wiz-body">
      <div id="wizPage1">
        <div id="requesterDeptBanner" class="alert-banner info" style="display:none"><div class="alert-ico">🏛️</div><div><div class="alert-text-title">سيتم تسجيل الطلب تحت إدارتك</div><div class="alert-text-sub" id="requesterDeptName">—</div></div></div>
        <div id="manualDeptBlock"><div class="sdv">🏢 الجهة الطالبة</div><div class="fg2" style="margin-bottom:18px"><div class="fg"><label>الجهة <span class="req">*</span></label><select id="requestingDept" onchange="onReqDept()"></select><input type="text" id="requestingDeptOther" placeholder="اكتب اسم الجهة" style="display:none;margin-top:8px"></div></div></div>
        <div class="sdv">👤 نوع الطلب</div>
        <div class="action-options" style="margin-bottom:18px">
          <div class="action-card selected" id="modeCard-single" onclick="setMode('single')"><div class="action-radio"></div><div class="action-ico">🧑</div><div class="action-body"><div class="action-title">فردي</div><div class="action-sub">تصريح واحد لشخص واحد</div></div></div>
          <div class="action-card" id="modeCard-multi" onclick="setMode('multi')"><div class="action-radio"></div><div class="action-ico">👥</div><div class="action-body"><div class="action-title">متعدد</div><div class="action-sub">كل شخص يحصل على تصريح مستقل</div></div></div>
        </div>
        <div class="sdv">🔍 اختيار الأشخاص <button type="button" class="btn bgold bxs" style="margin-right:auto" onclick="openAddPerson('',true)">➕ شخص جديد</button></div>
        <div class="fg"><input type="text" id="personSearchInput" placeholder="🔍 ابحث بالاسم أو رقم الهوية..." oninput="searchPersons(this.value)"><div class="search-results" id="personSearchResults" style="display:none"></div></div>
        <div class="chips-wrap" id="selectedPersonsChips"></div>
        <div class="hint" id="noPersonsHint">لم يتم اختيار أي شخص بعد</div>
      </div>
      <div id="wizPage2" style="display:none">
        <div class="sdv">📅 معلومات الزيارة</div>
        <div class="fg3" style="margin-bottom:12px">
          <div class="fg"><label>موعد الحضور</label><input type="date" id="visitDate"></div>
          <div class="fg"><label>تاريخ الانتهاء</label><input type="date" id="visitExpiry"></div>
          <div class="fg"><label>نوع الزيارة</label><select id="visitType"></select></div>
        </div>
        <div class="fg2" style="margin-bottom:16px">
          <div class="fg"><label>🏢 الفرع</label><select id="visitBranch" onchange="renderBuildingSelect();fillReqDept()"></select></div>
          <div class="fg"><label>🏬 المبنى</label><select id="visitBuilding" onchange="rpc2()"></select></div>
        </div>
        <div class="sdv">🛣️ المسار الافتراضي</div>
        <select id="pathChecklist" onchange="applyDefaultToAll()"></select>
        <div id="multiPeopleBlock" style="display:none;margin-top:18px">
          <div class="sdv">👥 جدول الأشخاص والتخصيص</div>
          <p class="hint" style="margin-bottom:10px">💡 المسار الافتراضي أعلاه يُطبق على الكل. اضغط <b>تخصيص</b> لتعديل مسار شخص معين.</p>
          <div class="people-table"><table><thead><tr><th style="width:35px">#</th><th>الشخص</th><th style="width:180px">🛣️ المسار</th><th style="width:150px">📅 الوقت</th><th style="width:110px">📱 المسموح</th><th style="width:200px">إجراءات</th></tr></thead><tbody id="multiPeopleTbody"></tbody></table></div>
        </div>
        <div id="singlePersonBlock" style="display:none;margin-top:18px">
          <div class="sdv">🧑 الشخص المختار</div>
          <div class="people-table"><table><thead><tr><th>#</th><th>الشخص</th><th>🛣️ المسار</th><th>📅 الوقت</th><th>📱 المسموح</th></tr></thead><tbody id="singlePersonTbody"></tbody></table></div>
        </div>
      </div>
      <div id="wizPage3" style="display:none">
        <div class="sdv">📱 المسموح بدخوله</div>
        <div class="check-grid" id="wizDeviceChecklist" style="margin-bottom:10px"></div>
        <button type="button" class="btn bg2 bsm" style="margin-bottom:20px" onclick="addDevice()">➕ إضافة غرض جديد</button>
        <div class="sdv">📎 المرفقات</div>
        <div class="upload-zone" onclick="document.getElementById('wizAttachInput').click()"><div class="upload-ico">📷</div><div class="upload-text">اضغط للرفع</div></div>
        <input type="file" id="wizAttachInput" multiple style="display:none" onchange="handleAttach(this.files)">
        <div id="wizAttachmentsList" style="margin-top:12px"></div>
        <div class="sdv">📝 الملاحظات</div>
        <div class="fg2">
          <div class="fg"><label>📝 ملاحظات مقدم الطلب</label><textarea rows="3" id="wizRequesterNotes"></textarea></div>
          <div class="fg"><label>🛡️ ملاحظات لموظف الاستعلام</label><textarea rows="3" id="wizGuardNotes"></textarea></div>
        </div>
      </div>
      <div id="wizPage4" style="display:none"></div>
    </div>
    <div class="bgrp" style="border-top:1px solid var(--g100);padding-top:16px">
      <button class="btn bg2" id="wizBackBtn" onclick="wizBack()" style="display:none">→ السابق</button>
      <button class="btn bp" id="wizNextBtn" onclick="wizNext()">التالي ←</button>
      <button class="btn bp" id="wizSendBtn" onclick="submitPermit()" style="display:none">📨 إرسال</button>
    </div>
  </div>
</div>

<!-- تصريح مركبة -->
<div class="screen" id="screen-vehicle">
  <div class="ph"><div><div class="pt">🚗 تصريح مركبة</div></div></div>
  <div class="grid2">
    <div class="card" style="padding:22px">
      <div class="sdv">🧑 السائق</div>
      <div class="fg" style="margin-bottom:16px"><select id="vehicleDriverSelect"></select></div>
      <div class="sdv">🚙 بيانات المركبة</div>
      <div class="fg3" style="margin-bottom:12px">
        <div class="fg"><label>التصنيف</label><select id="vehicleTypeSelect"></select></div>
        <div class="fg"><label>الشركة</label><select id="vehicleMakeSelect" onchange="onMakeChange()"></select></div>
        <div class="fg"><label>الموديل</label><select id="vehicleModelSelect" onchange="rvp()"></select></div>
      </div>
      <div class="fg3" style="margin-bottom:12px">
